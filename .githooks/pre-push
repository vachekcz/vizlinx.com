#!/usr/bin/env bash
set -euo pipefail

# Pre-push quality gate. Each step is wrapped in scripts/hook-run-step.sh, which
# stays quiet on success and prints a log tail on failure. Set HOOK_VERBOSE=1 to
# stream every step's output live.
#
# These steps mirror the cheap half of .github/workflows/verify-and-deploy.yml.
# Deliberately NOT run here, because they need browsers or start real servers
# and would push the hook past a minute: the Playwright suite (`npm test`),
# `test:extension`, `test:prototype` and `wrangler deploy --dry-run`. CI runs
# all of them, so a green pre-push is a strong signal, not a guarantee.
# When you add or remove a gate in CI, mirror it here.

# Escape hatch — same effect as `git push --no-verify`, but explicit and
# greppable in shell history:  HOOK_SKIP=1 git push
if [ "${HOOK_SKIP:-}" = "1" ]; then
  echo "⚠ HOOK_SKIP=1 — skipping local checks."
  exit 0
fi

# Nothing to check when the push only deletes remote branches (git push
# --delete) or pushes nothing. Git feeds pre-push one line per ref on stdin:
# "<local ref> <local sha> <remote ref> <remote sha>"; deletions have an
# all-zero local sha.
ZERO_SHA="0000000000000000000000000000000000000000"
HAS_CONTENT=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  if [ "$local_sha" != "$ZERO_SHA" ]; then
    HAS_CONTENT=1
  fi
done
if [ "$HAS_CONTENT" = "0" ]; then
  exit 0
fi

if [ ! -d "node_modules" ]; then
  echo "❌ node_modules is missing — run 'npm ci' and push again."
  exit 1
fi

ROOT="$(git rev-parse --show-toplevel)"
RUN_STEP="$ROOT/scripts/hook-run-step.sh"

if ! bash "$RUN_STEP" "Prettier check" npm run format:check --silent; then
  bash "$RUN_STEP" "Prettier auto-format" npm run format --silent
  echo ""
  echo "❌ Push stopped: prettier reformatted files."
  echo "   Review 'git status', commit the changes and push again."
  exit 1
fi

# Covers the typecheck too: `build` is tsc -b + vite build + the extension bundle.
bash "$RUN_STEP" "Build + typecheck" npm run build --silent

bash "$RUN_STEP" "API tests" npm run test:api --silent
bash "$RUN_STEP" "Crawler tests" npm run test:crawler --silent
bash "$RUN_STEP" "Scan log tests" npm run test:scan-log --silent
bash "$RUN_STEP" "Fetch result tests" npm run test:fetch-result --silent
bash "$RUN_STEP" "Benchmark tests" npm run test:benchmark --silent

echo "✅ Local checks passed — pushing."
