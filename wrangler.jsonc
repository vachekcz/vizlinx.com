{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vizlinx-com",
  "main": "worker/index.ts",
  "account_id": "6d98272604827024f82f94b330498ae7",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "CRAWLER_ENABLED": "true", "ADMIN_EMAIL": "" },
  "limits": { "cpu_ms": 5000 },
  "queues": {
    "producers": [{ "binding": "CRAWL_QUEUE", "queue": "vizlinx-com-crawl" }],
    "consumers": [
      {
        "queue": "vizlinx-com-crawl",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_concurrency": 3,
        "max_retries": 3,
        "retry_delay": 30,
      },
    ],
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vizlinx-scans",
      "database_id": "4f40989f-9a62-4310-9df4-46d964db72f5",
      // Keep the existing local database identity when production is configured.
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "routes": [
    { "pattern": "vizlinx.com", "custom_domain": true },
    { "pattern": "www.vizlinx.com", "custom_domain": true },
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
}
