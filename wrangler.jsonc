{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vizlinx-com",
  "main": "worker/index.ts",
  "account_id": "6d98272604827024f82f94b330498ae7",
  "compatibility_date": "2026-09-11",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vizlinx-scans",
      "database_id": "4f40989f-9a62-4310-9df4-46d964db72f5",
      // Keep the existing local database identity when production is configured.
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "routes": [
    { "pattern": "vizlinx.com", "custom_domain": true },
    { "pattern": "www.vizlinx.com", "custom_domain": true },
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
}
