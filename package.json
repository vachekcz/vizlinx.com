{
  "name": "vizlinx",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:full": "npm run build && npm run db:local && npm run dev:api",
    "build": "tsc -b && vite build && npm run build:extension",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "npm run build && npm run db:remote && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "test": "playwright test",
    "screenshots:tour": "playwright test -c playwright.screenshots.config.ts",
    "screenshots:gallery": "tsx scripts/build-screenshot-gallery.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:extension": "node scripts/build-extension.mjs",
    "test:api": "node scripts/test-api.mjs",
    "test:crawler": "node --test tests-api/crawler.test.mjs",
    "test:scan-log": "node --test tests-api/scan-log.test.mjs",
    "test:fetch-result": "node --test tests-api/fetch-result.test.mjs",
    "test:extension": "node scripts/test-extension.mjs",
    "test:prototype": "node scripts/test-prototype.mjs",
    "benchmark:scan": "node scripts/benchmark-scan.mjs",
    "test:benchmark": "node --test scripts/benchmark-scan.test.mjs",
    "dev:api": "wrangler dev --port 8797 --env-file=/dev/null",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "typegen": "wrangler types --env-file=/dev/null",
    "hooks:install": "bash scripts/setup-hooks.sh",
    "hooks:doctor": "bash scripts/check-hooks.sh",
    "postinstall": "if [ -f scripts/setup-hooks.sh ]; then bash scripts/setup-hooks.sh; fi"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^1.45.0",
    "parse5": "^8.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "robots-parser": "^3.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.2.9",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "miniflare": "^5.20260911.0-alpha",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.131.1"
  }
}
